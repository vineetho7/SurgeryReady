MEDPLUM_CLIENT_ID=3cf52225-8504-4ea3-925c-8a5f5a155236
MEDPLUM_CLIENT_SECRET=38530214637b75f2ed954b331f66be247f915513a0b0b26c8529b1998475d8c5

# ── Deepgram ───────────────────────────────────────────────────────────
# console.deepgram.com → API Keys. $200 free credits on signup.
# Same key covers STT, TTS, and the Voice Agent websocket.
DEEPGRAM_API_KEY=d25d379a5bc06594fae123dce02f45027457f32a

# ── Moss ───────────────────────────────────────────────────────────────
