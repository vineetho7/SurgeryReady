# SurgeryReady — copy to server/.env and fill in. .env is gitignored.
#
# THIS FILE IS COMMITTED. Never put a real value in it. Placeholders only.

# ── Medplum ────────────────────────────────────────────────────────────
# app.medplum.com → Project Admin → Client Applications → create one.
# Server-side writes use the client credentials flow.
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# ── Deepgram ───────────────────────────────────────────────────────────
# console.deepgram.com → API Keys. $200 free credits on signup.
# Same key covers STT, TTS, and the Voice Agent websocket.
DEEPGRAM_API_KEY=

# ── Moss ───────────────────────────────────────────────────────────────
# portal.usemoss.dev → Create Index. Free Developer plan, $5/mo credits.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# ── Stedi ──────────────────────────────────────────────────────────────
# Account name → API Keys → Generate new API Key, type = Test.
# Test-mode transactions are free and carry no PHI.
STEDI_API_KEY=

# ── Local ──────────────────────────────────────────────────────────────
PORT=8080
